# Use these only for real model evaluation.
EVAR_API_KEY=your_api_key_here
EVAR_BASE_URL=https://api.example.com/v1

# Optional separate endpoint for the paper's GPT-5.5 evaluator.
# If omitted, the evaluator falls back to EVAR_API_KEY / EVAR_BASE_URL.
EVAR_JUDGE_API_KEY=your_judge_api_key_here
EVAR_JUDGE_BASE_URL=https://api.example.com/v1

# OPENAI_API_KEY / OPENAI_BASE_URL are also accepted fallbacks.

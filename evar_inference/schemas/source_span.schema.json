{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_span.schema.json",
  "type": "object",
  "required": [
    "source_id",
    "quote",
    "start",
    "end"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}

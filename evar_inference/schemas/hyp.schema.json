{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["gap_id", "hypotheses"],
  "properties": {
    "gap_id": {"type": "string", "pattern": "^G[0-9]{3}$"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim"],
        "properties": {"claim": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

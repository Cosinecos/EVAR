{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "sufficient",
    "gaps"
  ],
  "properties": {
    "sufficient": {
      "type": "boolean"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "description",
          "blocking",
          "priority",
          "related_unit_ids"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^G[0-9]{3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "related_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^U[0-9]{3}$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sufficient": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "gaps": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "additionalProperties": false
}